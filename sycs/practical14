import breeze.linalg._
import breeze.plot._
import com.github.tototoshi.csv._

object Q14 extends App {

  val reader = CSVReader.open("src/main/resources/data.csv")
  val data = reader.all()
  reader.close()

  val rows = data.tail

  val age = rows.flatMap { row =>
    try {
      Some(row(2).trim.toDouble)
    } catch {
      case _: Exception => None
    }
  }

  val ages = DenseVector(age.toArray)

  // Create Figure
  val fig = Figure("Histogram of Student Ages")

  val plt = fig.subplot(0)

  plt += hist(ages, bins = 10)

  plt.xlabel = "Age"
  plt.ylabel = "Frequency"
  plt.title = "Histogram of Age"

  fig.refresh()
}
